{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lacosta-redesign-demo",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
